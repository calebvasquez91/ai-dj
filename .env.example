# Copy to .env and fill in. See prisma/schema.prisma and src/lib/storage.ts
# for how these are used.

# Local dev: "file:./dev.db" (SQLite, zero setup). Production: a Postgres
# connection string (e.g. from Neon, Supabase, or Vercel Postgres).
DATABASE_URL="file:./dev.db"

# Auth.js session signing secret. Generate one with `openssl rand -base64 32`
# — use a different value in production than in dev.
AUTH_SECRET=""

# "local" (saves uploads to disk under ./uploads, dev only — Vercel's
# serverless functions can't durably write to disk) or "blob" (Vercel Blob,
# required in production).
NEXT_PUBLIC_STORAGE_BACKEND="local"

# Required when NEXT_PUBLIC_STORAGE_BACKEND="blob" — Vercel provides this
# automatically once Blob storage is enabled on the project.
BLOB_READ_WRITE_TOKEN=""

# OAuth client ID for "Connect YouTube" (lib/googleAuth.ts) — a Google
# Identity Services token client running entirely client-side, so this is
# public by design (not a secret; origin-restriction in Cloud Console is
# what secures it). Create one yourself: Google Cloud Console -> APIs &
# Services -> Credentials -> OAuth client ID -> Web application, with this
# app's origin(s) under Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Server-only — never exposed client-side, unlike the Google client ID above.
# Used by src/app/api/tracks/[id]/stems/route.ts to call Replicate (hosting
# Demucs) for stem separation. Create one at replicate.com's dashboard under
# Account -> API tokens. Stem separation also requires
# NEXT_PUBLIC_STORAGE_BACKEND="blob" — Replicate needs a publicly reachable
# URL to fetch source audio from, which a local-backend track's sourceUrl
# isn't.
REPLICATE_API_TOKEN=""

# Server-only — never exposed client-side. Used by src/lib/ai-dj.ts (via
# src/app/api/dj/next-track/route.ts) to ask Claude to pick the next track
# during a Shuffle Play / AI DJ session. Create one at
# console.anthropic.com under Account -> API Keys. Without this set, AI DJ
# next-track picks silently fall back to a local BPM-proximity pick —
# shuffle still works, it just isn't AI-driven.
ANTHROPIC_API_KEY=""
