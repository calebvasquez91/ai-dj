// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres (Vercel/Neon) — same instance for local dev and production for
// now, no separate local database. Scalar-only columns (no native enums,
// no Json) were kept from the original SQLite-dev design but aren't load
// bearing here anymore; harmless either way.
datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  tracks       Track[]
  playlists    Playlist[]
}

model Track {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  artist         String
  durationSec    Float
  source         String   @default("local") // "local" | "youtube" — enforced in app code, not a DB enum
  storageKey     String // local backend: file id under ./uploads ; blob backend: full public URL ; youtube: the video id
  mimeType       String @default("audio/mpeg") // from the browser File's .type at upload time — served back as Content-Type ; unused for source="youtube"
  thumbnailUrl   String?
  playPreference String? // "must" | "do-not" | null — enforced in app code, not a DB enum
  createdAt      DateTime @default(now())

  // Cached best-effort analysis (src/lib/audio-analysis.ts's TrackAnalysis),
  // computed once client-side and persisted here so it never needs
  // recomputing after the first time.
  bpm               Float?
  bpmConfidence     Float?
  // How a YouTube track's bpm was determined — "metadata" (Deezer lookup)
  // or "tap" (manual tap-tempo); null/unused for local tracks, whose bpm
  // always comes from real per-sample analysis.
  bpmSource         String?
  beatGridOffsetSec Float?
  energyOnsetSec    Float?
  key               String?
  keyConfidence     Float?
  camelotKey        String?
  breakdownAtSec    Float?
  dropAtSec         Float?
  // Up to two ordered {buildAtSec, dropAtSec} pairs (src/lib/audio-analysis-core.ts's
  // findBuildDropPairs) — JSON.stringify'd, feeds Hot Cues 3-6. Separate
  // from dropAtSec above (a single global peak); empty/absent when the
  // detector can't confidently place a pair, never fabricated.
  buildDropPairsJson String?
  waveformPeaksJson String? // JSON.stringify(number[]) — plain String, not Prisma Json (SQLite portability)

  // Cached lyrical/thematic fingerprint (src/lib/lyrics.ts's LyricalFingerprint,
  // words/moodTags serialized as arrays) — never the lyrics text itself, just
  // a derived word/mood signal for compatibility scoring. null means "not
  // looked up yet"; an empty-but-present fingerprint means "looked up, no
  // lyrics found" — both are distinct from never having tried, so a track
  // with no findable lyrics doesn't get re-queried forever.
  lyricalFingerprintJson String?

  // Manually-set Hot Cue positions (src/lib/hot-cues.ts) — sparse,
  // JSON.stringify'd as {"<cueNumber 1-8>": seconds}. Cues not present here
  // fall back to the best-effort auto placement derived live from the
  // analysis fields above (or stay unset if that can't place one either);
  // a manual tap always wins over an auto placement, never the reverse.
  // The only source of hot cues for a YouTube track, which has no
  // waveform to auto-analyze at all.
  hotCueOverridesJson String?

  playlistTracks PlaylistTrack[]
  stemJobs       StemSeparationJob[]

  @@index([userId])
  // Prevents re-importing the same YouTube video twice for the same user
  // (storageKey holds the video id for source="youtube" rows); harmless for
  // local/blob rows since their storageKey is already unique by construction.
  @@unique([userId, storageKey])
}

/**
 * Real per-track stem separation (vocals/drums/bass/other), run once via
 * Replicate (hosting Demucs — see src/app/api/tracks/[id]/stems/route.ts)
 * and cached forever, same "compute once" philosophy as Track's own cached
 * analysis fields above. A separate model rather than more Track columns
 * because this has a real job lifecycle, not just a cached scalar — trackId
 * is deliberately not unique so a failed run can be retried without deleting
 * history; "current state" for a track is just its most recent row.
 */
model StemSeparationJob {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /** "pending" | "processing" | "ready" | "failed" — enforced in app code, matching Track.source's own convention, not a DB enum. */
  status String

  /** Replicate's own id for this run — used to poll it. */
  replicatePredictionId String
  /** The resolved model version actually used, for debugging/reproducibility — null until Replicate reports it back. */
  replicateModelVersion String?
  /** Set when status = "failed". */
  errorMessage String?

  /** Replicate's own metrics.predict_time (real GPU-seconds) — authoritative, populated once the job resolves. */
  predictTimeSec Float?
  /** predictTimeSec * a documented per-second rate constant (see the route) — labeled "estimated": Replicate's API reports compute time, not a dollar figure, directly. */
  estimatedCostUsd Float?

  // Final URLs in this app's own Blob storage (never Replicate's own,
  // temporary output URLs) — all null until status = "ready".
  vocalsUrl String?
  drumsUrl  String?
  bassUrl   String?
  otherUrl  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([trackId])
  @@index([status])
}

model Playlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  tracks    PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, trackId])
}
