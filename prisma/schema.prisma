// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres (Vercel/Neon) — same instance for local dev and production for
// now, no separate local database. Scalar-only columns (no native enums,
// no Json) were kept from the original SQLite-dev design but aren't load
// bearing here anymore; harmless either way.
datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  tracks       Track[]
  playlists    Playlist[]
  fxSounds     FxSound[]
  feedback     Feedback[]
  trackData    TrackUserData[]
  playEvents   PlayEvent[]
}

model Track {
  id             String   @id @default(cuid())
  /// The account that added the song (the library itself is shared). CAUTION: deleting that account deletes its songs for every
  /// account, and from every playlist. Before deleting an account, hand its songs on: UPDATE "Track" SET "userId" = '<admin id>' WHERE "userId" = '<id>';
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  artist         String
  durationSec    Float
  source         String   @default("local") // "local" | "youtube" — enforced in app code, not a DB enum
  storageKey     String // local backend: file id under ./uploads ; blob backend: full public URL ; youtube: the video id
  mimeType       String @default("audio/mpeg") // from the browser File's .type at upload time — served back as Content-Type ; unused for source="youtube"
  thumbnailUrl   String?
  playPreference String? // "must" | "do-not" | null — enforced in app code, not a DB enum
  createdAt      DateTime @default(now())

  // Cached best-effort analysis (src/lib/audio-analysis.ts's TrackAnalysis),
  // computed once client-side and persisted here so it never needs
  // recomputing after the first time.
  bpm               Float?
  bpmConfidence     Float?
  // How a YouTube track's bpm was determined — "metadata" (Deezer lookup)
  // or "tap" (manual tap-tempo); null/unused for local tracks, whose bpm
  // always comes from real per-sample analysis.
  bpmSource         String?
  beatGridOffsetSec Float?
  energyOnsetSec    Float?
  key               String?
  keyConfidence     Float?
  camelotKey        String?
  breakdownAtSec    Float?
  dropAtSec         Float?
  // Up to two ordered {buildAtSec, dropAtSec} pairs (src/lib/audio-analysis-core.ts's
  // findBuildDropPairs) — JSON.stringify'd, feeds Hot Cues 3-6. Separate
  // from dropAtSec above (a single global peak); empty/absent when the
  // detector can't confidently place a pair, never fabricated.
  buildDropPairsJson String?
  waveformPeaksJson String? // JSON.stringify(number[]) — plain String, not Prisma Json (SQLite portability)

  // Cached lyrical/thematic fingerprint (src/lib/lyrics.ts's LyricalFingerprint,
  // words/moodTags serialized as arrays) — never the lyrics text itself, just
  // a derived word/mood signal for compatibility scoring. null means "not
  // looked up yet"; an empty-but-present fingerprint means "looked up, no
  // lyrics found" — both are distinct from never having tried, so a track
  // with no findable lyrics doesn't get re-queried forever.
  lyricalFingerprintJson String?

  // Manually-set Hot Cue positions (src/lib/hot-cues.ts) — sparse,
  // JSON.stringify'd as {"<cueNumber 1-8>": seconds}. Cues not present here
  // fall back to the best-effort auto placement derived live from the
  // analysis fields above (or stay unset if that can't place one either);
  // a manual tap always wins over an auto placement, never the reverse.
  // The only source of hot cues for a YouTube track, which has no
  // waveform to auto-analyze at all.
  hotCueOverridesJson String?

  // JSON.stringify'd string array, e.g. ["halloween","spooky"] — user-set,
  // manually editable in the library UI. Drives the Spooky Music system
  // playlist's auto-membership (any track tagged halloween/spooky/horror/
  // dark/eerie) alongside its explicit PlaylistTrack rows. null/absent means
  // untagged, same "not looked up / not set" convention as the other
  // optional *Json columns on this model.
  tagsJson String?

  playlistTracks PlaylistTrack[]
  userData       TrackUserData[]
  playEvents     PlayEvent[]
  stemJobs       StemSeparationJob[]
  genreInfo      TrackGenre?
  genreJobs      GenreJob[]
  genreLogs      GenreLog[]

  @@index([userId])
  // Prevents re-importing the same YouTube video twice for the same user
  // (storageKey holds the video id for source="youtube" rows); harmless for
  // local/blob rows since their storageKey is already unique by construction.
  @@unique([userId, storageKey])
}

/**
 * Real per-track stem separation (vocals/drums/bass/other), run once via
 * Replicate (hosting Demucs — see src/app/api/tracks/[id]/stems/route.ts)
 * and cached forever, same "compute once" philosophy as Track's own cached
 * analysis fields above. A separate model rather than more Track columns
 * because this has a real job lifecycle, not just a cached scalar — trackId
 * is deliberately not unique so a failed run can be retried without deleting
 * history; "current state" for a track is just its most recent row.
 */
model StemSeparationJob {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /** "pending" | "processing" | "ready" | "failed" — enforced in app code, matching Track.source's own convention, not a DB enum. */
  status String

  /** Replicate's own id for this run — used to poll it. */
  replicatePredictionId String
  /** The resolved model version actually used, for debugging/reproducibility — null until Replicate reports it back. */
  replicateModelVersion String?
  /** Set when status = "failed". */
  errorMessage String?

  /** Replicate's own metrics.predict_time (real GPU-seconds) — authoritative, populated once the job resolves. */
  predictTimeSec Float?
  /** predictTimeSec * a documented per-second rate constant (see the route) — labeled "estimated": Replicate's API reports compute time, not a dollar figure, directly. */
  estimatedCostUsd Float?

  // Final URLs in this app's own Blob storage (never Replicate's own,
  // temporary output URLs) — all null until status = "ready".
  vocalsUrl String?
  drumsUrl  String?
  bassUrl   String?
  otherUrl  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([trackId])
  @@index([status])
}

model Playlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  tracks    PlaylistTrack[]
  playEvents PlayEvent[]

  // Marks a system-curated playlist (e.g. "spooky" for the built-in Spooky
  // Music playlist) — null for a normal user-made playlist. Used to key
  // Halloween-mode UI/audio off one flag rather than name-matching "Spooky
  // Music" as a string. Enforced in app code, not a DB enum.
  theme String?

  @@index([userId])
  // Lets ensureSpookyPlaylist (lib/playlistApi.ts) use a single atomic
  // upsert instead of a findFirst-then-create race — two concurrent calls
  // (e.g. two open tabs) can no longer create two "Spooky Music" rows for
  // the same user. Postgres treats NULL as distinct from NULL in a unique
  // index, so this still allows unlimited normal (theme=null) playlists.
  @@unique([userId, theme])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, trackId])
}

/**
 * A user-uploaded FX/stinger sound (riser, scratch, ambient loop, vocal
 * drop, etc.) available to be played as an overlay layer during a
 * transition or, for category="background", looped continuously under a
 * themed playlist. Same storage/mimeType/JSON-column conventions as Track
 * above — storageKey is a local file id or a Vercel Blob URL depending on
 * the active storage backend (see src/lib/storage.ts), *Json columns are
 * plain Strings (not Prisma Json) for the same reason Track's are.
 */
model FxSound {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  fileName String
  storageKey String
  mimeType   String @default("audio/mpeg")

  /** "transition" | "loop" | "effect" | "background" | "vocal" — enforced in app code, matching Track.source's own convention, not a DB enum. */
  category String

  durationSec Float
  /** User-entered, optional — most FX don't have a meaningful tempo/key, unlike a Track these are never auto-analyzed. */
  bpm Float?
  key String?

  /** JSON.stringify'd string array — free-text search/filter tags. */
  tagsJson String @default("[]")
  /** JSON.stringify'd string array, e.g. ["spooky","halloween"] — which themed playlists/modes this FX is eligible for. Checked by the Spooky Music system (requirement: Halloween mode pulls transition FX and background loops exclusively from here) and sent to the AI FX-matching call as part of each candidate's profile. */
  playlistAffinityJson String @default("[]")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category])
}

/// What a person told us about the app: a 1-5 rating and an optional comment, sent from the feedback pop-up. Kept so nothing
/// is lost if the notification email fails; `emailedAt` is set once the owner has been told.
model Feedback {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1-5, enforced in app code (src/lib/feedback.ts), not a DB check.
  rating  Int
  comment String @default("")

  /// Where the person was in the app (a path like "/library"), the app version and the browser's user agent: context for reading the comment.
  page       String?
  appVersion String?
  userAgent  String?

  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// A track's genres (src/lib/genre/): every tag with its source and confidence, the resolved summary, and whether a person
/// has confirmed it. One row per track, kept off Track itself so the library queries never depend on this table existing.
model TrackGenre {
  trackId String @id
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// JSON.stringify'd GenreTag[] (src/types/music.ts).
  tagsJson String @default("[]")
  /// "auto" | "needs-review" | "confirmed" - enforced in app code, not a DB enum.
  status String @default("auto")
  /// The resolved summary of tagsJson: the best genre, its subgenres, and the moods the sources named.
  genre         String?
  subgenresJson String   @default("[]")
  moodsJson     String   @default("[]")
  /// Facts the sources found about the track: its release year, and "explicit" | "clean" from the file's advisory tag.
  year          Int?
  explicit      String?
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([genre])
}

/// One classification run for a track, queued by an import, a "Re-classify" or the backfill, and worked off in the background
/// (src/app/api/genre/run/route.ts). At most one queued or running job per track (a partial unique index in prisma/genre-tables.sql).
model GenreJob {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// "queued" | "running" | "done" | "failed" - enforced in app code.
  status     String    @default("queued")
  /// Lower runs first: 0 an import or a person's request, 5 the backfill.
  priority   Int       @default(0)
  attempts   Int       @default(0)
  /// Not picked up before this time (the retry backoff).
  runAfter   DateTime  @default(now())
  lastError  String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAfter, priority])
  @@index([trackId])
}

/// What each provider has already told us, so the same lookup is never paid for twice (MusicBrainz, Last.fm, AcoustID, the LLM).
model ProviderCache {
  key       String   @id
  provider  String
  valueJson String
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([provider])
  @@index([expiresAt])
}

/// The last time each rate-limited provider was called, so the one-request-per-second rule holds across serverless instances.
model ProviderRateLimit {
  provider      String   @id
  lastRequestAt DateTime
}

/// One line per classification: which sources answered and what the track ended up as. Feeds the admin stats screen.
model GenreLog {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// The status the run ended with, and the best genre and confidence.
  status      String
  genre       String?
  confidence  Float?
  /// JSON.stringify'd { source, hit, tags, ms, error? }[] - one entry per provider that ran.
  sourcesJson String
  usedLlm     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([trackId])
  @@index([createdAt])
}

/// What one person keeps for themselves on a song everyone shares (Track): their "must / do-not play" mark and their own hot cues.
/// The song itself (title, tags, analysis, audio) is the same for every account; these two are not. No row = nothing set.
model TrackUserData {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// "must" | "do-not" - enforced in app code, not a DB enum.
  playPreference      String?
  /// JSON.stringify'd {"<cue 1-8>": seconds}, same shape as Track.hotCueOverridesJson.
  hotCueOverridesJson String?
  updatedAt           DateTime @updatedAt

  @@id([userId, trackId])
  @@index([trackId])
}

/// How long one account played one song, reported by the player about every 30 seconds while music is playing (the Admin page's
/// listening statistics). Title, artist, genre and playlist name are copied in so the numbers survive a deleted song or playlist.
model PlayEvent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    String?
  track      Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  title        String
  artist       String
  genre        String?
  playlistName String?
  seconds      Float
  createdAt    DateTime @default(now())
  /// When this row last grew: the player's reports for one song and playlist are added into one row while they keep coming, and this is
  /// the time of the account's latest report (the server measures a new report against it).
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@index([trackId])
  @@index([playlistId])
}

/// What the admin changed on a playlist that belongs to another account (renamed, took a song out, deleted it...). The playlist's name and
/// the owner's email are copied in, so the line still reads after the playlist or the account is gone. Not tied to the other tables.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  /// "playlist.rename" | "playlist.delete" | "playlist.add-song" | "playlist.remove-song" | "playlist.reorder"
  action       String
  playlistId   String?
  playlistName String
  ownerId      String?
  ownerEmail   String?
  detail       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---- Telemetry, audit and playlist images (prisma/telemetry.sql). All new tables, none touches an existing one, so the app keeps working
// ---- (and every call here is best effort) until the SQL has been run.

/// One install of the app, told apart by an anonymous id the browser makes for itself (a cookie). No name, no email: only the platform, the
/// OS and the app version, and when it was first and last seen. The heartbeat (every 30 seconds while the app is open) keeps lastSeenAt fresh.
model Device {
  id          String   @id
  /// The account that last used it (an id only; the account can be deleted without this table caring).
  lastUserId  String?
  platform    String   @default("web")
  os          String   @default("unknown")
  appVersion  String   @default("unknown")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

/// One stretch of the app being open on a device: it starts at the first heartbeat and lastBeatAt moves forward with each one, so the length of
/// a session is lastBeatAt - startedAt.
model AppSession {
  id         String   @id
  deviceId   String
  userId     String?
  startedAt  DateTime @default(now())
  lastBeatAt DateTime @default(now())

  @@index([deviceId, lastBeatAt])
  @@index([startedAt])
}

/// A line for each change to the library or a playlist: who (role), from which device, and what. Titles and names are copied in so the line still reads after the thing is gone.
model AuditEvent {
  id          String   @id @default(cuid())
  /// "song_added" | "song_removed" | "playlist_created" | "playlist_renamed" | "playlist_deleted" | "image_added" | "image_removed"
  eventType   String
  /// "user" | "admin"
  actorRole   String
  actorId     String?
  deviceId    String?
  targetId    String?
  targetLabel String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
}

/// Which device uploaded which song, and when.
model UploadRecord {
  id         String   @id @default(cuid())
  deviceId   String?
  userId     String
  trackId    String?
  trackTitle String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([deviceId])
}

/// The device a listening row (PlayEvent) was played on, kept beside it so PlayEvent itself is not changed.
model PlayEventDevice {
  playEventId String @id
  deviceId    String

  @@index([deviceId])
}

/// A playlist's own picture (a playlist without a row shows its song covers). Kept beside Playlist so Playlist itself is not changed.
model PlaylistImage {
  playlistId String   @id
  url        String
  updatedAt  DateTime @default(now()) @updatedAt
}

/// A playlist's holiday theme (waveform colours, accent tint and light particles while it plays; lib/holidayThemes.ts). Kept beside Playlist so
/// Playlist itself is not changed (prisma/holiday-themes.sql). A playlist without a row has none.
model PlaylistHoliday {
  playlistId String   @id
  /// One of the ten holiday ids in lib/holidayThemes.ts - enforced in app code, not a DB enum.
  holiday    String
  updatedAt  DateTime @default(now()) @updatedAt
}
